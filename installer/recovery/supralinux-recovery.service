[Unit]
Description=SupraLINUX Btrfs recovery instructions
ConditionKernelCommandLine=supralinux.recovery=1
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf "\n\nSupraLINUX recovery\nLogin as supralinux and run: sudo /usr/local/sbin/supralinux-recover\n\n" > /dev/tty1'

[Install]
WantedBy=multi-user.target
