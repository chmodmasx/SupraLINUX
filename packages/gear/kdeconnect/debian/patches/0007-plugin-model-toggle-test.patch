+    void testPluginModelAppliesImmediately()
+    {
+        QVERIFY(QDBusConnection::sessionBus().registerService(QStringLiteral("org.kde.kdeconnect")));
+
+        Device *d = nullptr;
+        const QList<Device *> devicesList = m_daemon->devicesList();
+        for (Device *id : devicesList) {
+            if (id->isReachable()) {
+                if (!id->isPaired())
+                    id->requestPairing();
+                d = id;
+                break;
+            }
+        }
+        QVERIFY(d);
+        QVERIFY(d->isPaired());
+        QVERIFY(d->isReachable());
+
+        const QString pluginId = QStringLiteral("kdeconnect_notifications");
+        PluginModel model;
+        model.setDeviceId(d->id());
+
+        int row = -1;
+        for (int i = 0; i < model.rowCount(); ++i) {
+            if (model.index(i, 0).data(PluginModel::IdRole).toString() == pluginId) {
+                row = i;
+                break;
+            }
+        }
+        if (row < 0)
+            QSKIP("kdeconnect_notifications plugin is not available");
+
+        const bool before = d->isPluginEnabled(pluginId);
+        QVERIFY(model.setData(model.index(row, 0), !before, Qt::CheckStateRole));
+        QTRY_COMPARE(d->isPluginEnabled(pluginId), !before);
+
+        QVERIFY(model.setData(model.index(row, 0), before, Qt::CheckStateRole));
+        QTRY_COMPARE(d->isPluginEnabled(pluginId), before);
+    }
+
 private:
     TestDaemon *m_daemon;
 };
