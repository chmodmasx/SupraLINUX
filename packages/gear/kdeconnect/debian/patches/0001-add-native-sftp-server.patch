+namespace
+{
+constexpr int StartupTimeoutMs = 8000;
+constexpr int StopTimeoutMs = 2000;
+constexpr qsizetype MaxErrorSize = 8192;
+
+QString bracketedAddress(const QString &address)
+{
+    if (address.contains(QLatin1Char(':')) && !address.startsWith(QLatin1Char('['))) {
+        return QLatin1Char('[') + address + QLatin1Char(']');
+    }
+    return address;
+}
+}
+
+SftpServerProcess::SftpServerProcess(const Device *device, QObject *parent)
+    : QObject(parent)
+    , m_device(device)
+{
+    m_startupTimer.setSingleShot(true);
+    connect(&m_startupTimer, &QTimer::timeout, this, &SftpServerProcess::startupTimeout);
+}
+
+SftpServerProcess::~SftpServerProcess()
+{
+    stop();
+}
+
+bool SftpServerProcess::isRunning() const
+{
+    return m_process && m_process->state() != QProcess::NotRunning;
+}
+
+QString SftpServerProcess::localIp() const
+{
+    return m_localIp;
+}
+
+quint16 SftpServerProcess::port() const
+{
+    return m_port;
+}
+
+QString SftpServerProcess::lastError() const
+{
+    return m_stderr;
+}
+
+QString SftpServerProcess::findServerExecutable() const
+{
+    const QString installed = QStringLiteral("/usr/libexec/supralinux-kdeconnect-sftp");
+    if (QFileInfo(installed).isExecutable()) {
+        return installed;
+    }
+    return QStandardPaths::findExecutable(QStringLiteral("supralinux-kdeconnect-sftp"));
+}
+
+QHostAddress SftpServerProcess::localAddressForPeer() const
+{
+    const QHostAddress peer = m_device ? m_device->getLocalIpAddress() : QHostAddress();
+    const auto interfaces = QNetworkInterface::allInterfaces();
+
+    // Prefer an IPv4 address on the same subnet as the paired device.
+    if (peer.protocol() == QAbstractSocket::IPv4Protocol) {
+        for (const QNetworkInterface &iface : interfaces) {
+            const auto flags = iface.flags();
+            if (!(flags & QNetworkInterface::IsUp) || (flags & QNetworkInterface::IsLoopBack)) {
+                continue;
+            }
+            for (const QNetworkAddressEntry &entry : iface.addressEntries()) {
+                const QHostAddress address = entry.ip();
+                if (address.protocol() != QAbstractSocket::IPv4Protocol) {
+                    continue;
+                }
+                const quint32 mask = entry.netmask().toIPv4Address();
+                if (mask != 0 && (peer.toIPv4Address() & mask) == (address.toIPv4Address() & mask)) {
+                    return address;
+                }
+            }
+        }
+    }
+
+    // Fall back to the first non-loopback IPv4 address, then IPv6.
+    for (const QNetworkInterface &iface : interfaces) {
+        const auto flags = iface.flags();
+        if (!(flags & QNetworkInterface::IsUp) || (flags & QNetworkInterface::IsLoopBack)) {
+            continue;
+        }
+        for (const QNetworkAddressEntry &entry : iface.addressEntries()) {
+            if (entry.ip().protocol() == QAbstractSocket::IPv4Protocol && !entry.ip().isLoopback()) {
+                return entry.ip();
+            }
+        }
+    }
+    for (const QNetworkInterface &iface : interfaces) {
+        const auto flags = iface.flags();
+        if (!(flags & QNetworkInterface::IsUp) || (flags & QNetworkInterface::IsLoopBack)) {
+            continue;
+        }
+        for (const QNetworkAddressEntry &entry : iface.addressEntries()) {
+            if (entry.ip().protocol() == QAbstractSocket::IPv6Protocol && !entry.ip().isLoopback()) {
+                return entry.ip();
+            }
+        }
+    }
+    return {};
+}
+
+void SftpServerProcess::start()
+{
+    stop();
+
+    if (!m_device) {
+        fail(tr("No device is associated with this SFTP request."));
+        return;
+    }
+
+    const QString executable = findServerExecutable();
+    if (executable.isEmpty()) {
+        fail(tr("The native KDE Connect SFTP server is not installed."));
+        return;
+    }
+
+    const QHostAddress localAddress = localAddressForPeer();
+    if (localAddress.isNull()) {
+        fail(tr("Could not determine a local network address for the SFTP server."));
+        return;
+    }
+    m_localIp = localAddress.toString();
+
+    QString runtimePath = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (runtimePath.isEmpty()) {
+        runtimePath = QDir::tempPath();
+    }
+    m_runtimeDir = std::make_unique<QTemporaryDir>(runtimePath + QStringLiteral("/kdeconnect-sftp-XXXXXX"));
+    if (!m_runtimeDir->isValid()) {
+        fail(tr("Could not create a temporary directory for the SFTP server."));
+        return;
+    }
+    QFile::setPermissions(m_runtimeDir->path(), QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner);
+
+    const QSslCertificate certificate = m_device->certificate();
+    if (certificate.isNull()) {
+        fail(tr("The paired device certificate is not available."));
+        return;
+    }
+    const QSslKey publicKey = certificate.publicKey();
+    if (publicKey.isNull()) {
+        fail(tr("Could not extract the paired device public key."));
+        return;
+    }
+
+    const QString keyPath = m_runtimeDir->filePath(QStringLiteral("paired-device.pub"));
+    QFile keyFile(keyPath);
+    if (!keyFile.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        fail(tr("Could not write the paired device public key."));
+        return;
+    }
+    keyFile.write(publicKey.toPem());
+    keyFile.close();
+    QFile::setPermissions(keyPath, QFile::ReadOwner | QFile::WriteOwner);
+
+    m_user = qEnvironmentVariable("USER");
+    if (m_user.isEmpty()) {
+        m_user = QFileInfo(QDir::homePath()).fileName();
+    }
+
+    const bool readOnly = configReadOnly();
+    const QString listenAddress = bracketedAddress(m_localIp) + QStringLiteral(":0");
+
+    QStringList arguments{
+        QStringLiteral("--listen"),
+        listenAddress,
+        QStringLiteral("--root"),
+        QDir::homePath(),
+        QStringLiteral("--user"),
+        m_user,
+        QStringLiteral("--authorized-key-file"),
+        keyPath,
+        QStringLiteral("--idle-timeout"),
+        QStringLiteral("2m"),
+        QStringLiteral("--startup-timeout"),
+        QStringLiteral("60s"),
+        QStringLiteral("--max-lifetime"),
+        QStringLiteral("8h"),
+    };
+    if (readOnly) {
+        arguments << QStringLiteral("--read-only");
+    }
+
+    m_process = new QProcess(this);
+    m_process->setProgram(executable);
+    m_process->setArguments(arguments);
+    m_process->setProcessChannelMode(QProcess::SeparateChannels);
+    connect(m_process, &QProcess::readyReadStandardOutput, this, &SftpServerProcess::readStandardOutput);
+    connect(m_process, &QProcess::readyReadStandardError, this, &SftpServerProcess::readStandardError);
+    connect(m_process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), this, &SftpServerProcess::processFinished);
+    connect(m_process, &QProcess::errorOccurred, this, &SftpServerProcess::processError);
+
+    m_ready = false;
+    m_port = 0;
+    m_stdoutBuffer.clear();
+    m_stderr.clear();
+    m_startupTimer.start(StartupTimeoutMs);
+    m_process->start();
+
+    qCDebug(KDECONNECT_PLUGIN_SFTP) << "Starting native SFTP server" << executable << arguments;
+}
+
+void SftpServerProcess::stop()
+{
+    m_startupTimer.stop();
+    m_ready = false;
+    m_port = 0;
+    m_stdoutBuffer.clear();
+
+    if (m_process) {
+        m_process->disconnect(this);
+        if (m_process->state() != QProcess::NotRunning) {
+            m_process->terminate();
+            if (!m_process->waitForFinished(StopTimeoutMs)) {
+                m_process->kill();
+                m_process->waitForFinished(StopTimeoutMs);
+            }
+        }
+        delete m_process;
+        m_process = nullptr;
+    }
+
+    m_runtimeDir.reset();
+    m_stderr.clear();
+}
+
+void SftpServerProcess::readStandardOutput()
+{
+    if (!m_process) {
+        return;
+    }
+    m_stdoutBuffer += m_process->readAllStandardOutput();
+    while (true) {
+        const qsizetype newline = m_stdoutBuffer.indexOf('\n');
+        if (newline < 0) {
+            break;
+        }
+        const QByteArray line = m_stdoutBuffer.left(newline).trimmed();
+        m_stdoutBuffer.remove(0, newline + 1);
+        if (!line.startsWith("PORT=")) {
+            continue;
+        }
+        bool ok = false;
+        const uint value = line.mid(5).toUInt(&ok);
+        if (!ok || value == 0 || value > 65535) {
+            continue;
+        }
+        m_port = static_cast<quint16>(value);
+        m_ready = true;
+        m_startupTimer.stop();
+        Q_EMIT ready(m_localIp, m_port, m_user);
+    }
+}
+
+void SftpServerProcess::readStandardError()
+{
+    if (!m_process) {
+        return;
+    }
+    const QByteArray data = m_process->readAllStandardError();
+    if (!data.isEmpty()) {
+        m_stderr += QString::fromLocal8Bit(data);
+        if (m_stderr.size() > MaxErrorSize) {
+            m_stderr = m_stderr.right(MaxErrorSize);
+        }
+        qCDebug(KDECONNECT_PLUGIN_SFTP) << "native SFTP server:" << data.trimmed();
+    }
+}
+
+void SftpServerProcess::processFinished(int exitCode, QProcess::ExitStatus status)
+{
+    const bool wasReady = m_ready;
+    const QString errorText = m_stderr;
+    if (m_process) {
+        m_process->deleteLater();
+        m_process = nullptr;
+    }
+    m_ready = false;
+    m_port = 0;
+    if (!wasReady) {
+        Q_EMIT failed(tr("The native SFTP server exited before it was ready (status %1, code %2). %3")
+                          .arg(status == QProcess::NormalExit ? QStringLiteral("normal") : QStringLiteral("crash"))
+                          .arg(exitCode)
+                          .arg(errorText));
+    }
+}
+
+void SftpServerProcess::processError(QProcess::ProcessError error)
+{
+    QString message;
+    if (error == QProcess::FailedToStart) {
+        message = tr("Could not start the native SFTP server.");
+    } else if (error == QProcess::Crashed) {
+        message = tr("The native SFTP server crashed.");
+    } else if (error != QProcess::UnknownError) {
+        message = tr("The native SFTP server failed: %1").arg(m_stderr);
+    }
+    if (!message.isEmpty()) {
+        QTimer::singleShot(0, this, [this, message]() {
+            fail(message);
+        });
+    }
+}
+
+void SftpServerProcess::startupTimeout()
+{
+    if (!m_ready) {
+        fail(tr("The native SFTP server did not become ready in time."));
+    }
+}
+
+void SftpServerProcess::fail(const QString &message)
+{
+    if (!message.isEmpty()) {
+        qCWarning(KDECONNECT_PLUGIN_SFTP) << message;
+    }
+    Q_EMIT failed(message);
+    stop();
+}
+
+bool SftpServerProcess::configReadOnly() const
+{
+    // The plugin config is a per-device KConfig key.  The default matches
+    // Android's remote-filesystem behavior: read/write.  Users who only want
+    // to browse can set readOnly=true without touching sshd or ~/.ssh.
+    if (!m_device) {
+        return false;
+    }
+    // SftpPlugin owns the config; this helper is implemented in the plugin
+    // and passed via a dynamic property to avoid exposing config() here.
+    const QVariant value = property("readOnly");
+    return value.isValid() && value.toBool();
+}
