+void SftpPlugin::startServer()
+{
+    stopServer();
+
+    m_server = new SftpServerProcess(device(), this);
+    m_server->setProperty("readOnly", config()->getBool(QStringLiteral("readOnly"), false));
+
+    connect(m_server, &SftpServerProcess::ready, this, [this](const QString &ip, quint16 port, const QString &user) {
+        NetworkPacket np(PACKET_TYPE_SFTP);
+        np.set(QStringLiteral("ip"), ip);
+        np.set(QStringLiteral("port"), static_cast<int>(port));
+        np.set(QStringLiteral("user"), user);
+        np.set(QStringLiteral("path"), QStringLiteral("/"));
+        // KDE Connect 25.12 requires the field to exist; this server only
+        // accepts the paired device's public key, so no password is used.
+        np.set(QStringLiteral("password"), QString());
+        np.set(QStringLiteral("multiPaths"), QStringList{QStringLiteral("/")});
+        np.set(QStringLiteral("pathNames"), QStringList{tr("Home")});
+        sendPacket(np);
+    });
+
+    connect(m_server, &SftpServerProcess::failed, this, [this](const QString &message) {
+        NetworkPacket np(PACKET_TYPE_SFTP);
+        np.set(QStringLiteral("errorMessage"), message);
+        sendPacket(np);
+    });
+
+    m_server->start();
+}
+
+void SftpPlugin::stopServer()
+{
+    if (m_server) {
+        delete m_server;
+        m_server = nullptr;
+    }
+}
