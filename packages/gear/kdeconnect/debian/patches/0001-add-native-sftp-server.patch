+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QHostAddress>
+#include <QObject>
+#include <QProcess>
+#include <QString>
+#include <QTemporaryDir>
+#include <QTimer>
+
+#include <memory>
+
+class Device;
+
+/**
+ * Launches the ephemeral native SFTP server for one paired device.
+ *
+ * The server is a plain user process: it listens on a random high port, only
+ * accepts the paired device's certificate key, and exits after the mount goes
+ * away.  It never touches sshd, port 22 or the user's ~/.ssh.
+ */
+class SftpServerProcess : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SftpServerProcess(const Device *device, QObject *parent = nullptr);
+    ~SftpServerProcess() override;
+
+    void start();
+    void stop();
+
+    bool isRunning() const;
+    QString localIp() const;
+    quint16 port() const;
+    QString lastError() const;
+
+Q_SIGNALS:
+    void ready(const QString &ip, quint16 port, const QString &user);
+    void failed(const QString &message);
+
+private Q_SLOTS:
+    void readStandardOutput();
+    void readStandardError();
+    void processFinished(int exitCode, QProcess::ExitStatus status);
+    void processError(QProcess::ProcessError error);
+    void startupTimeout();
+
+private:
+    QString findServerExecutable() const;
+    QHostAddress localAddressForPeer() const;
+    bool configReadOnly() const;
+    void fail(const QString &message);
+
+    const Device *m_device;
+    QProcess *m_process = nullptr;
+    std::unique_ptr<QTemporaryDir> m_runtimeDir;
+    QTimer m_startupTimer;
+    QByteArray m_stdoutBuffer;
+    QString m_stderr;
+    QString m_localIp;
+    QString m_user;
+    quint16 m_port = 0;
+    bool m_ready = false;
+};
