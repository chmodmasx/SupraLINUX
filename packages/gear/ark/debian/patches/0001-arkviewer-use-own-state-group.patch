Description: Give the internal preview a default size and its own state group
 The internal preview is a separate KParts::MainWindow. setupGUI(ToolBar)
 calls adjustSize() while the window is still hidden, so the empty header
 shrinks it to its minimum size (around 224x148). Pass the UI geometry
 (800x600) as the default size. Also keep the preview's size and position
 in its own "Viewer" state group instead of sharing Ark's main window state.
Origin: https://invent.kde.org/utilities/ark/-/merge_requests/360
Forwarded: no
Last-Update: 2026-11-20

--- a/part/arkviewer.cpp
+++ b/part/arkviewer.cpp
@@ -42,7 +42,7 @@
     closeAction->setShortcut(Qt::Key_Escape);
 
     setXMLFile(QStringLiteral("ark_viewer.rc"));
-    setupGUI(ToolBar);
+    setupGUI(size(), ToolBar);
 }
 
 ArkViewer::~ArkViewer()
@@ -202,6 +202,7 @@
     connect(action, &QAction::triggered, this, &ArkViewer::aboutKPart);
 
     createGUI(m_part.data());
+    setStateConfigGroup(QStringLiteral("Viewer"));
     setAutoSaveSettings(QStringLiteral("Viewer"), true);
 
     m_part.data()->openUrl(QUrl::fromLocalFile(fileName));
