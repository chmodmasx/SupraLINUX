#!/bin/sh
set -e

file=/usr/share/locale/es_AR/LC_MESSAGES/calamares-python.mo
backup=${file}.calamares-data

if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
    if [ -e "$backup" ]; then
        dpkg-divert --package supralinux-calamares-config --divert "$backup" --add "$file" >/dev/null
    elif [ -e "$file" ]; then
        dpkg-divert --package supralinux-calamares-config --divert "$backup" --rename "$file" >/dev/null
    else
        dpkg-divert --package supralinux-calamares-config --divert "$backup" --add "$file" >/dev/null
    fi
fi

exit 0
