#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true

# AppArmor caches compiled profiles. The local include for linux-boot-prober
# is new, so drop its cached copy and reload it before update-grub runs.
rm -f /var/cache/apparmor/*/linux-boot-prober
if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r -T /etc/apparmor.d/linux-boot-prober >/dev/null 2>&1 || true
fi

if command -v update-grub >/dev/null 2>&1; then
    update-grub >/dev/null 2>&1 || true
fi
if [ -x /usr/lib/supralinux/fix-firefox-desktop ] && [ -e /usr/bin/firefox ]; then
    /usr/lib/supralinux/fix-firefox-desktop >/dev/null 2>&1 || true
fi

# Plasma 6 uses ksecretd, not the old kwalletd5. Tell pam_kwallet5 which daemon
# to start, and wire the autologin stack for the LUKS key when available.
if [ -f /etc/pam.d/sddm ]; then
    if grep -q 'pam_kwallet5\.so.*auto_start' /etc/pam.d/sddm; then
        if ! grep -q 'pam_kwallet5\.so.*kwalletd=' /etc/pam.d/sddm; then
            sed -i '/pam_kwallet5\.so.*auto_start/ s/$/ kwalletd=\/usr\/bin\/ksecretd/' /etc/pam.d/sddm
        fi
    fi
fi

if [ -f /etc/pam.d/sddm-autologin ]; then
    if ! grep -q 'pam_systemd_loadkey\.so' /etc/pam.d/sddm-autologin; then
        sed -i '/^auth[[:space:]]\+required[[:space:]]\+pam_permit\.so/a -auth optional pam_systemd_loadkey.so\n-auth optional pam_kwallet5.so' /etc/pam.d/sddm-autologin
    fi
    if ! grep -q 'pam_kwallet5\.so.*auto_start' /etc/pam.d/sddm-autologin; then
        sed -i '/^@include common-session/a -session optional pam_kwallet5.so auto_start force_run kwalletd=\/usr\/bin\/ksecretd' /etc/pam.d/sddm-autologin
    fi
fi

# Existing installations receive the same blank wallet as a new autologin
# setup, but only when there is no wallet yet, no LUKS and autologin is on.
if [ -x /usr/local/sbin/supralinux-kwallet-setup ]; then
    /usr/local/sbin/supralinux-kwallet-setup || true
fi

# Make org.freedesktop.secrets activatable for existing users. New users get
# the same file from /etc/skel. It is installed per user because a system-wide
# file would conflict with gnome-keyring's org.freedesktop.secrets.service.
if [ -x /usr/bin/ksecretd ] && [ -f /usr/share/supralinux/kwallet-blank/org.freedesktop.secrets.service ]; then
    getent passwd | while IFS=: read -r user _ uid gid _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        [ "$uid" -lt 60000 ] 2>/dev/null || continue
        [ -d "$home" ] || continue
        target="$home/.local/share/dbus-1/services/org.freedesktop.secrets.service"
        [ -e "$target" ] && continue
        install -d -m 755 "$home/.local/share/dbus-1" "$home/.local/share/dbus-1/services" || continue
        if install -m 644 /usr/share/supralinux/kwallet-blank/org.freedesktop.secrets.service "$target"; then
            chown "$user:$gid" "$target" 2>/dev/null || true
        fi
        chown "$user:$gid" "$home/.local/share/dbus-1" "$home/.local/share/dbus-1/services" 2>/dev/null || true
    done
fi

# Create the legacy utmp/utmpx/wtmp files used by sddm-helper. systemd-logind
# remains the authoritative session tracker; these files only restore the
# compatibility records written by SDDM.
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/supralinux-utmp.conf >/dev/null 2>&1 || true
fi

# Existing installations: allow administrators to inspect snapshots without
# sudo and keep the .snapshots ACLs in sync. New installations get this from
# the Calamares Btrfs setup script.
if command -v snapper >/dev/null 2>&1 && [ -e /etc/snapper/configs/root ]; then
    snapper --no-dbus -c root set-config ALLOW_GROUPS=sudo >/dev/null 2>&1 || true
    snapper --no-dbus -c root set-config SYNC_ACL=yes >/dev/null 2>&1 || true
fi

exit 0
