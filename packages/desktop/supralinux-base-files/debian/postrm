#!/bin/sh
set -e

remove_divert() {
    file="$1"
    backup="${file}.supralinux-distrib"
    if [ -e "$backup" ]; then
        dpkg-divert --package supralinux-base-files --divert "$backup" --rename --remove "$file" >/dev/null
    else
        dpkg-divert --package supralinux-base-files --divert "$backup" --remove "$file" >/dev/null
    fi
}

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    remove_divert /usr/lib/os-release
    remove_divert /etc/lsb-release
    remove_divert /etc/issue
    remove_divert /etc/issue.net
    remove_divert /etc/legal
    remove_divert /etc/update-motd.d/10-help-text
fi

exit 0
