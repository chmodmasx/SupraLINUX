<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SupraLINUX</vendor>
  <vendor_url>https://supralinux.com/</vendor_url>

  <action id="com.supralinux.recovery.run">
    <description>Restaurar una instantánea de SupraLINUX</description>
    <description xml:lang="en">Restore a SupraLINUX snapshot</description>
    <message>Se requiere autorización para restaurar la raíz del sistema.</message>
    <message xml:lang="en">Authorization is required to restore the system root.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/supralinux-recovery-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
