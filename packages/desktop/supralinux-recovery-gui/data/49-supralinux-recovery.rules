// The recovery GUI is live-only. This rule lets the live user start the
// privileged helper without a password; the package is removed from the
// installed system by the Calamares cleanup job.
polkit.addRule(function(action, subject) {
    if (action.id == "com.supralinux.recovery.run" &&
        subject.user == "supralinux" &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
