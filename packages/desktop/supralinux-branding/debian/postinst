#!/bin/sh
set -e
if command -v update-grub >/dev/null 2>&1; then
    update-grub >/dev/null 2>&1 || true
fi
if [ -f /usr/share/plymouth/themes/supralinux/supralinux.plymouth ]; then
    update-alternatives --install \
        /usr/share/plymouth/themes/default.plymouth default.plymouth \
        /usr/share/plymouth/themes/supralinux/supralinux.plymouth 200 >/dev/null 2>&1 || true
    update-alternatives --set default.plymouth \
        /usr/share/plymouth/themes/supralinux/supralinux.plymouth >/dev/null 2>&1 || true
fi
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u >/dev/null 2>&1 || true
fi
exit 0
