Description: Allow showing the administrative action inside the home directory
 kio-admin hides "Open as Administrator" for items under $HOME. Distributions
 may want the action available everywhere by default while keeping a way to
 restore the upstream behavior. Read ShowInHome from kio-adminrc (default
 true) and skip the home check when enabled.
Author: SupraLINUX Project <packages@supralinux.invalid>
Forwarded: no
Last-Update: 2026-11-22

--- a/src/fileaction/fileaction.cpp
+++ b/src/fileaction/fileaction.cpp
@@ -6,11 +6,13 @@
 #include <QWidget>
 
 #include <KAbstractFileItemActionPlugin>
+#include <KConfigGroup>
 #include <KFileItem>
 #include <KFileItemListProperties>
 #include <KIO/OpenFileManagerWindowJob>
 #include <KLocalizedString>
 #include <KPluginFactory>
+#include <KSharedConfig>
 
 class Plugin : public KAbstractFileItemActionPlugin
 {
@@ -28,10 +30,13 @@
             return {};
         }
         const auto items = fileItemInfos.items();
-        if (std::all_of(items.cbegin(), items.cend(), [](const KFileItem &item) {
-                auto url = item.mostLocalUrl();
-                return url.path().startsWith(QDir::homePath());
-            })) {
+        const KConfigGroup config = KSharedConfig::openConfig(QStringLiteral("kio-adminrc"))
+                                        ->group(QStringLiteral("General"));
+        if (!config.readEntry(QStringLiteral("ShowInHome"), true)
+            && std::all_of(items.cbegin(), items.cend(), [](const KFileItem &item) {
+                   auto url = item.mostLocalUrl();
+                   return url.path().startsWith(QDir::homePath());
+               })) {
             return {};
         }
 
