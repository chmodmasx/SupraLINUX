#!/usr/bin/make -f
# -*- makefile -*-

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_QCH=OFF -DBUILD_TESTING=OFF

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
	install -D -m 0644 debian/etc/xdg/baloofilerc debian/tmp/etc/xdg/baloofilerc
