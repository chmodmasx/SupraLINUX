diff -ruN a/kcms/users/src/passwordless.cpp b/kcms/users/src/passwordless.cpp
--- a/kcms/users/src/passwordless.cpp	1969-12-31 21:00:00.000000000 -0300
+++ b/kcms/users/src/passwordless.cpp	2026-11-02 09:25:07.998244685 -0300
@@ -0,0 +1,150 @@
+/*
+    SPDX-FileCopyrightText: 2026 SupraLINUX Project
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+
+#include "passwordless.h"
+
+#include <KLocalizedString>
+
+#include <grp.h>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+constexpr auto s_groupName = "supralinux-passwordless";
+
+bool validUserName(const QString &userName)
+{
+    if (userName.isEmpty() || userName.size() > 64) {
+        return false;
+    }
+    for (const QChar c : userName) {
+        if (!(c.isLetterOrNumber() || c == u'_' || c == u'-' || c == u'.')) {
+            return false;
+        }
+    }
+    return !userName.startsWith(u'-');
+}
+} // namespace
+
+Passwordless::Passwordless(QObject *parent)
+    : QObject(parent)
+{
+}
+
+bool Passwordless::enabled() const
+{
+    return m_enabled;
+}
+
+bool Passwordless::busy() const
+{
+    return m_busy;
+}
+
+QString Passwordless::error() const
+{
+    return m_error;
+}
+
+bool Passwordless::userInPasswordlessGroup(const QString &userName)
+{
+    const QByteArray group = QByteArray(s_groupName);
+    const QByteArray user = userName.toUtf8();
+    if (struct group *entry = getgrnam(group.constData())) {
+        for (char **member = entry->gr_mem; *member; ++member) {
+            if (qstrcmp(*member, user.constData()) == 0) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+void Passwordless::refresh(const QString &userName)
+{
+    m_userName = userName;
+    const bool next = validUserName(userName) && userInPasswordlessGroup(userName);
+    if (m_enabled != next) {
+        m_enabled = next;
+        Q_EMIT enabledChanged();
+    }
+}
+
+void Passwordless::clearError()
+{
+    setError({});
+}
+
+void Passwordless::setBusy(bool busy)
+{
+    if (m_busy != busy) {
+        m_busy = busy;
+        Q_EMIT busyChanged();
+    }
+}
+
+void Passwordless::setError(const QString &error)
+{
+    if (m_error != error) {
+        m_error = error;
+        Q_EMIT errorChanged();
+    }
+}
+
+void Passwordless::setEnabled(const QString &userName, bool enabled)
+{
+    if (m_busy) {
+        return;
+    }
+    if (!validUserName(userName)) {
+        setError(i18n("Invalid user name."));
+        return;
+    }
+
+    m_userName = userName;
+    m_requestedState = enabled;
+    setError({});
+    setBusy(true);
+
+    m_process = new QProcess(this);
+    m_process->setProcessChannelMode(QProcess::MergedChannels);
+    connect(m_process, &QProcess::errorOccurred, this, [this](QProcess::ProcessError) {
+        finishProcess();
+    });
+    connect(m_process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this, [this](int, QProcess::ExitStatus) {
+        finishProcess();
+    });
+
+    m_process->start(QStringLiteral("/usr/bin/pkexec"),
+                     {QStringLiteral("/usr/lib/supralinux/supralinux-passwordless-helper"),
+                      m_requestedState ? QStringLiteral("enable") : QStringLiteral("disable"),
+                      userName});
+}
+
+void Passwordless::finishProcess()
+{
+    if (!m_process) {
+        return;
+    }
+
+    const int exitCode = m_process->exitStatus() == QProcess::NormalExit ? m_process->exitCode() : -1;
+    const QString output = QString::fromUtf8(m_process->readAll()).trimmed();
+    m_process->deleteLater();
+    m_process = nullptr;
+
+    if (exitCode != 0) {
+        setError(output.isEmpty() ? i18n("Could not change passwordless administration.") : output);
+        setBusy(false);
+        return;
+    }
+
+    setError({});
+    setBusy(false);
+    refresh(m_userName);
+    if (m_enabled != m_requestedState) {
+        setError(i18n("The requested state could not be verified."));
+    }
+}
diff -ruN a/kcms/users/src/passwordless.h b/kcms/users/src/passwordless.h
--- a/kcms/users/src/passwordless.h	1969-12-31 21:00:00.000000000 -0300
+++ b/kcms/users/src/passwordless.h	2026-11-02 09:25:07.998152553 -0300
@@ -0,0 +1,47 @@
+/*
+    SPDX-FileCopyrightText: 2026 SupraLINUX Project
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QProcess>
+#include <QString>
+
+class Passwordless : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool enabled READ enabled NOTIFY enabledChanged)
+    Q_PROPERTY(bool busy READ busy NOTIFY busyChanged)
+    Q_PROPERTY(QString error READ error NOTIFY errorChanged)
+
+public:
+    explicit Passwordless(QObject *parent = nullptr);
+
+    bool enabled() const;
+    bool busy() const;
+    QString error() const;
+
+    Q_INVOKABLE void refresh(const QString &userName);
+    Q_INVOKABLE void setEnabled(const QString &userName, bool enabled);
+    Q_INVOKABLE void clearError();
+
+Q_SIGNALS:
+    void enabledChanged();
+    void busyChanged();
+    void errorChanged();
+
+private:
+    static bool userInPasswordlessGroup(const QString &userName);
+    void setBusy(bool busy);
+    void setError(const QString &error);
+    void finishProcess();
+
+    QProcess *m_process = nullptr;
+    bool m_enabled = false;
+    bool m_busy = false;
+    QString m_error;
+    QString m_userName;
+    bool m_requestedState = false;
+};
