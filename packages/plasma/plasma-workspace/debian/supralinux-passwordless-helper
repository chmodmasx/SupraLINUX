#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# SupraLINUX passwordless administration helper.
#
# Invoked through pkexec by the Users KCM.  It only accepts enable/disable
# for an existing administrator (member of the sudo group), and manages a
# dedicated group so the setting is per-user and easy to audit/remove.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

action="${1:-}"
user="${2:-}"
group="supralinux-passwordless"
sudoers="/etc/sudoers.d/90-supralinux-passwordless"
polkit="/etc/polkit-1/rules.d/49-supralinux-passwordless.rules"

usage() {
    echo "usage: $0 enable|disable USER" >&2
    exit 2
}

case "$action" in
    enable|disable) ;;
    *) usage ;;
esac

case "$user" in
    ""|*[!A-Za-z0-9_.-]*|-*) usage ;;
esac

getent passwd "$user" >/dev/null || {
    echo "Unknown user: $user" >&2
    exit 3
}

# Only administrator accounts are allowed.  This is the same sudo group that
# Calamares assigns to the administrator account.
if ! id -nG "$user" | tr ' ' '\n' | grep -qx sudo; then
    echo "Only administrator accounts can use passwordless administration." >&2
    exit 4
fi

if [ "$action" = "enable" ]; then
    getent group "$group" >/dev/null 2>&1 || groupadd --system "$group"

    tmp_sudoers=$(mktemp)
    trap 'rm -f "$tmp_sudoers"' EXIT
    printf '%%%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$group" > "$tmp_sudoers"
    chmod 0440 "$tmp_sudoers"
    visudo -cf "$tmp_sudoers" >/dev/null
    install -m 0440 -o root -g root "$tmp_sudoers" "$sudoers"
    rm -f "$tmp_sudoers"
    trap - EXIT

    tmp_polkit=$(mktemp)
    trap 'rm -f "$tmp_polkit"' EXIT
    cat > "$tmp_polkit" <<'EOF'
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("supralinux-passwordless")) {
        return polkit.Result.YES;
    }
});
EOF
    chmod 0644 "$tmp_polkit"
    install -m 0644 -o root -g root "$tmp_polkit" "$polkit"
    rm -f "$tmp_polkit"
    trap - EXIT

    gpasswd -a "$user" "$group" >/dev/null
    logger -t supralinux-passwordless "enabled for $user"
    echo "Passwordless administration enabled for $user."
else
    gpasswd -d "$user" "$group" >/dev/null 2>&1 || true

    members=$(getent group "$group" 2>/dev/null | cut -d: -f4 || true)
    if [ -z "$members" ]; then
        rm -f "$sudoers" "$polkit"
        groupdel "$group" 2>/dev/null || true
    fi
    logger -t supralinux-passwordless "disabled for $user"
    echo "Passwordless administration disabled for $user."
fi
